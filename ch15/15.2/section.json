 "footnotes": [
  {
   "id": "c-energy-of-state",
   "kind": "correction",
   "html": "The second product is the number of atoms in the excited state multiplied by the energy of that state."
  },
  {
   "id": "c-kt",
   "kind": "correction",
   "html": "At room temperature $k_BT$ is about 1/40 eV (0.026 eV at 300 K), which is what the factor $e^{40}$ for a 1 eV gap uses."
  },
  {
   "id": "c-exponential",
   "kind": "correction",
   "html": "What falls exponentially is the population of a level, with the level's energy divided by $k_BT$. Raising the temperature raises the upper level's share."
  },
  {
   "id": "c-degeneracy",
   "kind": "correction",
   "html": "$g_1$ and $g_2$ are the degeneracies of the two levels: the number of states that share each level's energy, not a number of electrons."
  }
