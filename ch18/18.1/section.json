 "exercises": [
  {
   "id": "a1",
   "source_id": "This is usually a very large number",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "many-states",
   "prompt": "<p>Argon (39.95 u) fills a 1.00 L flask at 298.15 K. Find (a) its thermal wavelength $\\kLambdath$ in picometers, (b) its translational partition function $\\kqtrans$ in the flask, and (c) the number of translational states per atom, $\\kqtrans/N$, at 1.00 bar, where each atom has $k\\kT/p$ of volume to itself.</p>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 16.0,
      "unit": "pm",
      "hint": "$m = 39.95 \\times 1.6605\\times10^{-27}$ kg; $\\Lambda = h/\\sqrt{2\\pi mkT}$."
     },
     {
      "part": "b",
      "value": 2.44e+29
     },
     {
      "part": "c",
      "value": 10100000.0
     }
    ],
    "solution": "<p>(a) $m = 6.634\\times10^{-26}$ kg, so $2\\pi mkT = 2\\pi(6.634\\times10^{-26})(1.381\\times10^{-23})(298.15) = 1.716\\times10^{-45}$ J kg and $\\kLambdath = (6.626\\times10^{-34})/\\sqrt{1.716\\times10^{-45}} = 1.600\\times10^{-11}$ m $= 16.0$ pm. (b) $\\kqtrans = \\kV/\\kLambdath^3 = (1.00\\times10^{-3}\\ \\text{m}^3)/(1.600\\times10^{-11}\\ \\text{m})^3 = 2.44\\times10^{29}$. (c) $k\\kT/p = (1.381\\times10^{-23})(298.15)/(1.00\\times10^5) = 4.12\\times10^{-26}$ m³, and $4.12\\times10^{-26}/(1.600\\times10^{-11})^3 = 1.01\\times10^7$. Each atom has about ten million translational states to itself.</p>"
   }
  }
 ],
