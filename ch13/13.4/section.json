 "exercises": [
  {
   "id": "a1",
   "source_id": "Usually, $D$ is ignored in the calculations",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "nonrigid-spectrum",
   "prompt": "<p>For HCl, $\\kBt = 10.4$ cm⁻¹ and $\\kDt = 0.0004$ cm⁻¹. For the level $J = 20$, find (a) the rigid-rotor term $\\kBt J(J+1)$, (b) the centrifugal stretching term $\\kDt J^2(J+1)^2$ and (c) the stretching term as a percentage of the rigid-rotor term.</p>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 4368,
      "unit": "cm⁻¹",
      "hint": "J(J + 1) = 420 at J = 20."
     },
     {
      "part": "b",
      "value": 70.6,
      "unit": "cm⁻¹"
     },
     {
      "part": "c",
      "value": 1.62,
      "unit": "%"
     }
    ],
    "solution": "<p>(a) $\\kBt J(J+1) = (10.4)(20)(21) = 4368$ cm⁻¹.</p><p>(b) $\\kDt J^2(J+1)^2 = (0.0004)(420)^2 = (0.0004)(176\\,400) = 70.6$ cm⁻¹.</p><p>(c) $70.6/4368 = 0.0162$, or 1.62%. Even at $J = 20$ the stretching lowers the level by less than 2%, and at low $J$ it is far smaller, since it grows as $J^4$ against $J^2$.</p>"
   }
  }
