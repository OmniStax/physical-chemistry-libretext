 "exercises": [
  {
   "id": "a1",
   "source_id": "Using stoichiometry we can define the extent",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "extent-of-reaction",
   "prompt": "<p>A vessel holds 1.00 mol N₂ and 3.00 mol H₂. After some time the reaction N₂ + 3H₂ → 2NH₃ has formed 0.40 mol NH₃.</p><ol type=\"a\"><li>What is the extent of reaction $\\kxiext$?</li><li>How much N₂ is left?</li><li>How much H₂ is left?</li></ol>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 0.2,
      "unit": "mol",
      "hint": "For a product, n = n₀ + vξ, and NH₃ starts at zero."
     },
     {
      "part": "b",
      "value": 0.8,
      "unit": "mol"
     },
     {
      "part": "c",
      "value": 2.4,
      "unit": "mol"
     }
    ],
    "solution": "<p>(a) NH₃ is a product with $v = 2$ and starts at zero, so $0.40\\ \\text{mol} = 2\\kxiext$ and $\\kxiext = 0.20$ mol.</p><p>(b) $n_{\\text{N}_2} = 1.00 - 1 \\times 0.20 = 0.80$ mol.</p><p>(c) $n_{\\text{H}_2} = 3.00 - 3 \\times 0.20 = 2.40$ mol. Every species gives the same $\\kxiext$ once its amount change is divided by its own coefficient.</p>"
   }
  }
 ],
