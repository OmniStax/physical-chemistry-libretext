 "exercises": [
  {
   "id": "a1",
   "source_id": "We took two different paths to get start and end at the same points",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "entropy-along-two-paths",
   "prompt": "<p>One mole of a monatomic ideal gas ($\\kCv = \\tfrac{3}{2}R$) at 298.15 K triples its volume. Path A is a reversible isotherm. Path B + C is a reversible adiabat followed by heating at constant volume back to 298.15 K.</p><ol type=\"a\"><li>What is $\\Delta\\kSA$?</li><li>What is $\\kqrevA$?</li><li>What temperature $\\kTtwo$ does the adiabat reach?</li><li>What is $\\kqrevC$?</li></ol>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 9.13,
      "unit": "J/K"
     },
     {
      "part": "b",
      "value": 2723,
      "unit": "J"
     },
     {
      "part": "c",
      "value": 143.3,
      "unit": "K",
      "hint": "Along a reversible adiabat of a monatomic gas, $\\kT V^{2/3}$ stays constant."
     },
     {
      "part": "d",
      "value": 1931,
      "unit": "J"
     }
    ],
    "solution": "<p>a. $\\Delta\\kSA = \\knmol R\\ln\\dfrac{\\kVb}{\\kVa} = (8.314)\\ln 3 = 9.13$ J/K.</p><p>b. $\\kqrevA = \\knmol R\\kT\\ln 3 = (8.314)(298.15)(1.0986) = 2723$ J.</p><p>c. $\\kTtwo = (298.15\\ \\text{K})\\,3^{-2/3} = 143.3$ K.</p><p>d. $\\kqrevC = \\kCv(\\kTone - \\kTtwo) = (12.47)(298.15 - 143.3) = 1931$ J. The heat along B + C is smaller than along A, but $\\kCv\\ln(298.15/143.3) = 9.13$ J/K, the same entropy change.</p>"
   }
  }
 ],
