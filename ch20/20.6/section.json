 "exercises": [
  {
   "id": "ai1",
   "source_id": "eq:Molar Entropy",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "mixing-of-two-gases",
   "prompt": "<p>1.00 mol of N<sub>2</sub> and 3.00 mol of O<sub>2</sub>, both ideal gases at the same pressure and temperature, are separated by a wall that is then removed. Find the entropy of mixing per mole of gas, $\\Delta \\kSbar$, and the total entropy change $\\Delta \\kSent$.</p>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 4.675,
      "unit": "J K⁻¹ mol⁻¹",
      "hint": "The mole fractions are 0.25 and 0.75."
     },
     {
      "part": "b",
      "value": 18.7,
      "unit": "J/K"
     }
    ],
    "solution": "<p>$\\chi_{N_2} = 1.00/4.00 = 0.25$ and $\\chi_{O_2} = 0.75$. Equation 20.6.4 gives $\\Delta \\kSbar = -R\\left[0.25\\ln 0.25 + 0.75\\ln 0.75\\right] = -(8.314\\ \\text{J K}^{-1}\\text{mol}^{-1})(-0.3466 - 0.2158) = 4.675\\ \\text{J K}^{-1}\\text{mol}^{-1}$. For all 4.00 mol, $\\Delta \\kSent = \\kntot \\Delta \\kSbar = 18.70\\ \\text{J/K}$. Both terms are positive, as every $\\ln \\chi_i$ is negative, so mixing always raises the entropy; an even mix would give the most, $R\\ln 2 = 5.76\\ \\text{J K}^{-1}\\text{mol}^{-1}$.</p>"
   }
  }
 ],
