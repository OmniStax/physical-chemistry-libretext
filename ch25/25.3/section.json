 "exercises": [
  {
   "id": "a1",
   "source_id": "Boiling point elevation is quite similar",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "melting-point-depression",
   "prompt": "<p>Water has $\\kTmstar = 273.15$ K and a molar enthalpy of fusion of 6006 J/mol. It boils at 373.15 K with a molar enthalpy of vaporization of 40.65 kJ/mol. Its molar mass is $M_1 = 0.018015$ kg/mol.</p><ol type=\"a\"><li>What is $K_f$ for water?</li><li>The same reasoning at the boiling point, with the vapor in place of the solid, gives $K_b = \\kR T_b^{*2}M_1/\\Delta_{vap}H$. What is $K_b$ for water?</li></ol>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 1.86,
      "unit": "K kg/mol",
      "hint": "$K_f = \\kR\\kTmstar^{2}M_1/\\kDeltafusHone$, all in SI units."
     },
     {
      "part": "b",
      "value": 0.513,
      "unit": "K kg/mol"
     }
    ],
    "solution": "<p>a. $K_f = \\dfrac{\\kR\\kTmstar^{2}M_1}{\\kDeltafusHone} = \\dfrac{(8.314)(273.15)^2(0.018015)}{6006} = 1.86$ K kg/mol.</p><p>b. $K_b = \\dfrac{(8.314)(373.15)^2(0.018015)}{40650} = 0.513$ K kg/mol. The enthalpy of vaporization is almost seven times that of fusion, so the same molality raises the boiling point only about a quarter as much as it lowers the melting point.</p>"
   }
  },
  {
   "id": "a2",
   "source_id": "From molality and weight we can then calculate molar mass",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "melting-point-depression",
   "prompt": "<p>1.00 g of an unknown nonvolatile compound dissolved in 50.0 g of water lowers its melting point by $\\kDeltaT = 0.207$ K. Take $K_f = 1.86$ K kg/mol.</p><ol type=\"a\"><li>What is the molality of the solution?</li><li>What is the molar mass of the compound?</li></ol>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 0.111,
      "unit": "mol/kg"
     },
     {
      "part": "b",
      "value": 180,
      "unit": "g/mol",
      "hint": "The molality times the mass of water in kilograms is the amount of solute."
     }
    ],
    "solution": "<p>a. $\\km = \\kDeltaT/K_f = 0.207/1.86 = 0.111$ mol/kg.</p><p>b. The solution holds $(0.111\\ \\text{mol/kg})(0.0500\\ \\text{kg}) = 5.56\\times10^{-3}$ mol of solute, so its molar mass is $1.00\\ \\text{g}/5.56\\times10^{-3}\\ \\text{mol} = 180$ g/mol.</p>"
   }
  }
 ],
