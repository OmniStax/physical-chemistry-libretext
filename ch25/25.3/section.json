     },
     "steps": [
      {
       "tex": "\\mk{l}{\\dfrac{\\partial \\ln a_1}{\\partial \\kT}} = \\mk{r}{-\\dfrac{1}{\\kR}\\dfrac{\\partial}{\\partial \\kT} \\dfrac{\\kDeltamuone}{\\kT}}",
       "uses": [],
       "cap": "Differentiate both sides with respect to $\\kT$; $\\kR$ is a constant."
      },
      {
       "tex": "\\mk{l}{\\dfrac{\\partial \\ln a_1}{\\partial \\kT}} = \\mk{r}{-\\dfrac{1}{\\kR}\\cdot\\dfrac{-\\kDeltafusHone}{\\kT^2}}",
       "uses": [
