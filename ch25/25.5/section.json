 "exercises": [
  {
   "id": "a1",
   "source_id": "Analogous to the mean ionic activity, we can define a",
   "kind": "exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "activity-coefficients",
   "prompt": "<p>A solution of CaCl<sub>2</sub> has molality $m = 0.010$ mol/kg and mean ionic activity coefficient $γ_\\pm = 0.73$. Find (a) the mean ionic molality $m_\\pm$ and (b) the activity $a_2$ of the salt.</p>",
   "answer": {
    "type": "multi",
    "generated_by": "ai",
    "parts": [
     {
      "part": "a",
      "value": 0.0159,
      "unit": "mol/kg",
      "hint": "CaCl₂ gives $ν_+ = 1$ and $ν_- = 2$, so $m_+ = m$ and $m_- = 2m$."
     },
     {
      "part": "b",
      "value": 1.56e-06
     }
    ],
    "solution": "<p>CaCl<sub>2</sub> dissociates into one Ca<sup>2+</sup> and two Cl<sup>−</sup>, so $ν_+ = 1$, $ν_- = 2$ and $ν = 3$. The ion molalities are $m_+ = 0.010$ mol/kg and $m_- = 0.020$ mol/kg.</p><p>(a) $m_\\pm^3 = m_+m_-^2 = (0.010)(0.020)^2 = 4.0\\times10^{-6}$, so $m_\\pm = 4^{1/3}(0.010) = 0.0159$ mol/kg.</p><p>(b) $a_2 = a_\\pm^3 = γ_\\pm^3 m_\\pm^3 = (0.73)^3(4.0\\times10^{-6}) = 1.56\\times10^{-6}$, with $m_\\pm$ taken relative to 1 mol/kg. Without the activity coefficient the activity would be $4.0\\times10^{-6}$; the ions' attraction lowers it by a factor of 0.39.</p>"
   }
  }
 ],
