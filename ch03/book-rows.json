     "ktex": "\\kpsi(\\krvec) = \\sqrt{\\dfrac{8}{V}}\\sin \\left( \\dfrac{n_{x} \\pi \\kx}{\\kLx} \\right) \\sin \\left(\\dfrac{n_{y} \\pi \\ky}{\\kLy}\\right) \\sin \\left(\\dfrac{ n_{z} \\pi \\kz}{\\kLz} \\right)"
    }
   ]
